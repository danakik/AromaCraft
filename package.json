{
  "name": "aromacraft",
  "version": "1.0.0",
  "main": "script.js",
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.8",
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "@svgr/webpack": "^8.1.0",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.0.1",
    "css-loader": "^7.1.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "scripts": {
    "start": "electron .",
    "build": "webpack",
    "dev": "npm run build && npm start",
    "pr": "prettier --write .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.aromacraft",
    "productName": "AromaCraft",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.ico"
    },
    "mac": {
      "icon": "src/assets/icons/icon.icns"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "script.js",
      "main.html",
      "!node_modules/**/*"
    ],
    "extraResources": [
      "src/assets/icons/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.2.3",
    "@hookform/resolvers": "^3.9.1",
    "@reduxjs/toolkit": "^2.2.8",
    "cross-spawn": "^7.0.6",
    "i18next": "^24.2.1",
    "i18next-electron-fs-backend": "^3.0.2",
    "lodash": "^4.17.21",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.8.4",
    "react": "^18.3.1",
    "react-charts": "^3.0.0-beta.57",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.4.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-toastify": "^10.0.6",
    "reactjs-stylesheet": "^1.0.9",
    "yup": "^1.4.0"
  }
}
